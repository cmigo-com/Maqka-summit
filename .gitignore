# Dependencies
node_modules/

# Environment secrets -- never commit real .env files, only .env.example
.env
.env.local
.env.*.local

# Database (generated by `npm run seed` / runtime writes)
backend/src/db/*.sqlite
backend/src/db/*.sqlite-journal
backend/src/db/*.sqlite-wal
backend/src/db/*.sqlite-shm

# Note: backend/public/uploads/ is intentionally NOT ignored -- it currently ships the
# real photos the gallery seed data (seed.js) references. If this grows with genuine
# runtime admin uploads later, revisit whether it belongs in version control at all.

# Frontend build output
frontend/dist/

# Logs
npm-debug.log*
*.log

# OS/editor cruft
.DS_Store
.vscode/
