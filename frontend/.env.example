# Leave unset for local development -- vite.config.js proxies /api and /uploads
# to http://localhost:4000, so the app defaults to relative '/api' calls automatically.
#
# For production (e.g. deploying this frontend to Vercel while the backend runs
# elsewhere, since the backend needs a persistent filesystem for SQLite + uploaded
# photos -- see backend/README notes), set this to your deployed backend's URL:
#
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
